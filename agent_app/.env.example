# Database: pick one
DATABASE_URL=sqlite:///./agent_app.db
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/agent_app
# DATABASE_URL=mysql+pymysql://app:app@localhost:3306/agent_app

# Redis: leave empty for an in-process fake (fine on a laptop)
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# Defaults for new users (each user can change these in the UI)
DEFAULT_FRAMEWORK=deepagents      # deepagents | langgraph | adk | claude
DEFAULT_MODE=scripted             # scripted (no keys) | live (real models)

# Live mode models and keys
LC_MODEL=anthropic:claude-sonnet-5-5
ADK_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

RATE_LIMIT_PER_MIN=120
TOOL_CACHE_TTL=300
