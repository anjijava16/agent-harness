# Copy to .env. Only fill in the services you want to run with --live.

# --- generic OpenAI-compatible model for the build-alikes (Muse, Cowork, Instinct, Hermes, Comet)
# Works with OpenAI, xAI (https://api.x.ai/v1), OpenRouter, Azure OpenAI, Ollama, LiteLLM proxy...
PA_BASE_URL=
PA_API_KEY=
PA_MODEL=gpt-4.1-mini

# --- s01 Grok Bot (xai-sdk) / s15 Cursor
XAI_API_KEY=
XAI_MODEL=grok-4.7
CURSOR_API_KEY=
CURSOR_REPO_URL=

# --- s02 dots, s17 Codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- s03 Duet, s18 Claude Agent SDK, s19 Deep Agents
ANTHROPIC_API_KEY=
DEEP_MODEL=anthropic:claude-sonnet-4-6

# --- s04 Gemini Task, s20 ADK
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- s07 Cue, s11 Manus
MANUS_API_KEY=

# --- s08 OpenClaw (your own gateway)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main

# --- s10 Personal Computer
PERPLEXITY_API_KEY=
PPLX_PRESET=pro-search

# --- s13 Genspark remote MCP (OAuth 2.1 access token)
GENSPARK_MCP_URL=
GENSPARK_MCP_TOKEN=
GENSPARK_TOOL=

# --- s16 Devin
DEVIN_API_KEY=
DEVIN_ORG_ID=
